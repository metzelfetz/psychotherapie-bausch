---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Prose from './Prose.astro';
import Aside from './Aside.astro';
import ContactCTA from './ContactCTA.astro';
import CvTimeline from './CvTimeline.astro';
import Map from './Map.astro';
import { practice } from '../data/practice';
import { counterpart, langOf, pagesFor, urlFor, type Page } from '../i18n/pages';
import { t } from '../i18n/ui';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const lang = langOf(page);
const tr = t(lang);
const { Content } = await render(page);
const other = await counterpart(page);
const alternateUrl = other ? urlFor(lang === 'de' ? 'en' : 'de', other.data.slug) : undefined;
const { hero, cv, trainings, highlights, aside, band, showMap, cta, layout } = page.data;

// The home page's eyebrow names the practice; other pages use their title.
const isHome = page.data.slug === '';
const eyebrow = isHome ? `${practice.practiceName[lang]} · ${practice.cityLong[lang]}` : page.data.title;

// The hero's secondary link points to the next page in the navigation.
const navPages = (await pagesFor(lang)).filter((p) => p.data.nav);
const nextPage = navPages[navPages.findIndex((p) => p.id === page.id) + 1];
const next = nextPage && { href: urlFor(lang, nextPage.data.slug), title: nextPage.data.title };

const groups = [
  ...(highlights ?? []),
  ...(trainings?.length ? [{ label: tr('cv.trainings'), items: trainings }] : []),
];
const hasAside = groups.length > 0 || aside !== undefined;
---

<BaseLayout
  lang={lang}
  title={page.data.title}
  description={page.data.description}
  noindex={layout === 'legal'}
  alternateUrl={alternateUrl}
>
  {hero && <Hero lang={lang} eyebrow={eyebrow} {...hero} next={next} />}

  {layout === 'legal' ? (
    <section class="px-4 pt-12 pb-20 md:pt-20">
      <div class="mx-auto max-w-6xl">
        <Prose>
          <h1 class="!font-[380] text-[clamp(2.4rem,4.6vw,3.6rem)]">{page.data.title}</h1>
          <Content />
        </Prose>
      </div>
    </section>
  ) : (
    <>
      <section class="bg-base-200 px-4 py-14 md:py-24">
        <div class:list={['mx-auto max-w-6xl', { 'grid gap-12 md:grid-cols-[minmax(0,40rem)_minmax(0,18rem)] md:justify-between md:gap-16': hasAside }]}>
          <Prose lead>
            {!hero && <h1>{page.data.title}</h1>}
            <Content />
          </Prose>
          {hasAside && <Aside lang={lang} groups={groups} facts={aside} />}
        </div>
      </section>

      {cv && (
        <section class="px-4 pt-14 md:pt-24">
          <div class="mx-auto max-w-6xl">
            <p class="eyebrow reveal mb-10">{tr('cv.heading')}</p>
            <CvTimeline cv={cv} />
          </div>
        </section>
      )}

      {showMap && (
        <section class="px-4 pt-14 md:pt-24">
          <div class="mx-auto max-w-6xl">
            <Map lang={lang} />
          </div>
        </section>
      )}

      {band && (
        <section class="px-4 pt-14 md:pt-24">
          <div class="reveal mx-auto max-w-6xl">
            <Image
              src={band.image}
              alt={band.imageAlt}
              widths={[640, 1200, 1800, 2400]}
              sizes="(min-width: 72rem) 72rem, 100vw"
              class="aspect-[4/3] w-full rounded-[2rem] object-cover object-[35%_center] md:aspect-[21/9]"
            />
          </div>
        </section>
      )}

      {cta && (
        <section class="px-4 py-14 md:py-24">
          <div class="mx-auto max-w-6xl">
            <ContactCTA lang={lang} text={cta} />
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
