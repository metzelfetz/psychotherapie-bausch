---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Prose from './Prose.astro';
import ContactCTA from './ContactCTA.astro';
import CvTimeline from './CvTimeline.astro';
import LocationCard from './LocationCard.astro';
import { locations } from '../data/practice';
import { practiceJsonLd } from '../data/jsonld';
import { counterpart, langOf, sectionsFor, urlFor, type Page } from '../i18n/pages';
import { t } from '../i18n/ui';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const lang = langOf(page);
const tr = t(lang);
const { Content } = await render(page);
const other = await counterpart(page);
const alternateUrl = other ? urlFor(lang === 'de' ? 'en' : 'de', other.data.slug) : undefined;
const { hero, cta, layout } = page.data;

// Two kinds of page: the one-pager at the root (hero, the sections, one
// contact box at the end) and the legal pages.
const isHome = page.data.slug === '';
const sections = isHome
  ? await Promise.all(
      (await sectionsFor(lang)).map(async (s) => ({ ...s.data, Content: (await render(s)).Content })),
    )
  : [];
const jsonLd = isHome ? practiceJsonLd(lang, new URL(urlFor(lang, ''), Astro.site).toString()) : undefined;
const locationById = Object.fromEntries(locations.map((l) => [l.id, l]));
---

<BaseLayout
  lang={lang}
  title={page.data.title}
  description={page.data.description}
  noindex={layout === 'legal'}
  alternateUrl={alternateUrl}
  jsonLd={jsonLd}
>
  {hero && <Hero lang={lang} {...hero} />}

  {layout === 'legal' ? (
    <section class="px-4 pt-12 pb-20 md:pt-20">
      <div class="mx-auto max-w-6xl">
        <Prose>
          <h1 class="!font-[380] text-[clamp(2.4rem,4.6vw,3.6rem)]">{page.data.title}</h1>
          <Content />
        </Prose>
      </div>
    </section>
  ) : (
    <>
      {sections.map(({ title, anchor, cv, links, locations: cards, Content: SectionContent }, i) => (
        <section
          id={anchor}
          aria-labelledby={`${anchor}-title`}
          class:list={['scroll-mt-22 px-4 py-14 md:scroll-mt-24 md:py-24', i % 2 === 0 ? 'bg-base-200' : 'bg-base-100']}
        >
          <div class="mx-auto max-w-6xl">
            <Prose lead>
              <h2 id={`${anchor}-title`}>{title}</h2>
              <SectionContent />
            </Prose>

            {cv && (
              <div class="mt-12 md:mt-16">
                <CvTimeline cv={cv} />
              </div>
            )}

            {links && (
              <div class="reveal mt-4 max-w-[50rem]">
                <p class="mb-4">{links.text}</p>
                <ul class="link-cards">
                  {links.items.map((l) => (
                    <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
                  ))}
                </ul>
              </div>
            )}

            {cards && (
              <div class="mt-10 grid gap-6 md:mt-14 md:grid-cols-2 md:gap-8">
                {cards.map((c) => <LocationCard lang={lang} location={locationById[c.id]} text={c.text} />)}
              </div>
            )}
          </div>
        </section>
      ))}

      {cta && (
        <section class="px-4 py-14 md:py-24">
          <div class="mx-auto max-w-6xl">
            <ContactCTA lang={lang} text={cta} />
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
