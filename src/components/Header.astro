---
import { navFor, urlFor } from '../i18n/pages';
import { languages, t, type Lang } from '../i18n/ui';
import { mailto, practice } from '../data/practice';

interface Props {
  lang: Lang;
  alternateUrl?: string;
}

const { lang, alternateUrl } = Astro.props;
const tr = t(lang);
// The nav links are anchors on the one-pager.
const nav = await navFor(lang);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
// Split at the "·" so a narrow screen wraps the subline between its parts.
const taglineParts = practice.tagline[lang].split(' · ');
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-base-100/85 backdrop-blur-md transition-colors duration-300"
>
  <div class="relative mx-auto flex min-h-15 max-w-6xl items-center gap-4 px-4 md:min-h-18 xl:gap-6">
    <a href={urlFor(lang, '')} class="mr-auto leading-tight no-underline">
      <span class="block font-serif text-xl font-[450] tracking-tight md:text-2xl">{practice.practiceName[lang]}</span>
      <span class="block text-[0.75rem] text-muted md:text-[0.8rem] md:tracking-wide">
        {taglineParts.map((part, i) => (
          <span class="inline-block whitespace-nowrap">{part}{i < taglineParts.length - 1 && <span aria-hidden="true">&nbsp;·&nbsp;</span>}</span>
        ))}
      </span>
    </a>

    <!-- Checkbox-driven mobile menu: no client JS needed to open or close it. -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <nav aria-label={tr('nav.label')} class="hidden items-center gap-0.5 lg:flex xl:gap-1">
      {nav.map((n) => (
        <a href={n.href} class="nav-link whitespace-nowrap text-base">{n.label}</a>
      ))}
      {alternateUrl && (
        <a
          href={alternateUrl}
          hreflang={otherLang}
          lang={otherLang}
          class="nav-link whitespace-nowrap text-sm uppercase tracking-widest text-muted"
          aria-label={tr('lang.switch')}
        >
          {otherLang}
        </a>
      )}
    </nav>
    <a href={mailto(lang)} class="btn btn-primary btn-sm hidden whitespace-nowrap lg:inline-flex">{tr('nav.cta')}</a>

    <label for="nav-toggle" class="btn btn-square btn-ghost lg:hidden" aria-label={tr('menu.open')}>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M4 8h16M4 16h16" />
      </svg>
    </label>

    <div id="nav-menu" class="absolute inset-x-0 top-full hidden flex-col border-b border-base-300 bg-base-100 px-4 pt-2 pb-6 peer-checked:flex lg:hidden">
      {nav.map((n) => (
        <a href={n.href} class="border-b border-base-300 px-2 py-3 text-lg">{n.label}</a>
      ))}
      {alternateUrl && (
        <a
          href={alternateUrl}
          hreflang={otherLang}
          lang={otherLang}
          class="border-b border-base-300 px-2 py-3 text-lg"
          aria-label={tr('lang.switch')}
        >
          {languages[otherLang]}
        </a>
      )}
      <a href={mailto(lang)} class="btn btn-primary mt-4">{tr('nav.cta')}</a>
    </div>
  </div>
</header>

<script>
  // Adds a hairline under the header once the page scrolls.
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    document.addEventListener('scroll', onScroll, { passive: true });
  }

  // The mobile menu's links are anchors on the same page: close the menu
  // when one is followed, so the section is not hidden behind it.
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  document.querySelectorAll('#nav-menu a').forEach((a) =>
    a.addEventListener('click', () => {
      if (toggle) toggle.checked = false;
    }),
  );
</script>
