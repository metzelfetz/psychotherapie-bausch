---
import { pagesFor, urlFor } from '../i18n/pages';
import { languages, t, type Lang } from '../i18n/ui';
import { mailto, practice } from '../data/practice';

interface Props {
  lang: Lang;
  alternateUrl?: string;
}

const { lang, alternateUrl } = Astro.props;
const tr = t(lang);
const navPages = (await pagesFor(lang)).filter((p) => p.data.nav);
const current = Astro.url.pathname.replace(/\/?$/, '/');
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const tagline = practice.tagline[lang].replace(' | ', ' · ');
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-base-100/85 backdrop-blur-md transition-colors duration-300"
>
  <div class="relative mx-auto flex min-h-15 max-w-6xl items-center gap-4 px-4 md:min-h-18 xl:gap-6">
    <a href={urlFor(lang, '')} class="mr-auto leading-tight no-underline">
      <span class="block font-serif text-xl font-[450] tracking-tight md:text-2xl">{practice.name}</span>
      <span class="block whitespace-nowrap text-[0.7rem] text-muted md:text-[0.8rem] md:tracking-wide">{tagline}</span>
    </a>

    <!-- Checkbox-driven mobile menu: no client JS needed to open or close it. -->
    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <nav aria-label={tr('nav.label')} class="hidden items-center gap-0.5 lg:flex xl:gap-1">
      {navPages.map((p) => {
        const href = urlFor(lang, p.data.slug);
        return (
          <a href={href} class="nav-link whitespace-nowrap text-base" aria-current={href === current ? 'page' : undefined}>
            {p.data.title}
          </a>
        );
      })}
      {alternateUrl && (
        <a
          href={alternateUrl}
          hreflang={otherLang}
          lang={otherLang}
          class="nav-link whitespace-nowrap text-sm uppercase tracking-widest text-muted"
          aria-label={tr('lang.switch')}
        >
          {otherLang}
        </a>
      )}
    </nav>
    <a href={mailto(lang)} class="btn btn-primary btn-sm hidden whitespace-nowrap lg:inline-flex">{tr('nav.cta')}</a>

    <label for="nav-toggle" class="btn btn-square btn-ghost lg:hidden" aria-label={tr('menu.open')}>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M4 8h16M4 16h16" />
      </svg>
    </label>

    <div class="absolute inset-x-0 top-full hidden flex-col border-b border-base-300 bg-base-100 px-4 pt-2 pb-6 peer-checked:flex lg:hidden">
      {navPages.map((p) => {
        const href = urlFor(lang, p.data.slug);
        return (
          <a
            href={href}
            class="border-b border-base-300 px-2 py-3 text-lg aria-[current=page]:font-semibold aria-[current=page]:text-secondary-content"
            aria-current={href === current ? 'page' : undefined}
          >
            {p.data.title}
          </a>
        );
      })}
      {alternateUrl && (
        <a
          href={alternateUrl}
          hreflang={otherLang}
          lang={otherLang}
          class="border-b border-base-300 px-2 py-3 text-lg"
          aria-label={tr('lang.switch')}
        >
          {languages[otherLang]}
        </a>
      )}
      <a href={mailto(lang)} class="btn btn-primary mt-4">{tr('nav.cta')}</a>
    </div>
  </div>
</header>

<script>
  // Adds a hairline under the header once the page scrolls.
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    document.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
