---
// Long-form page text: one column at a readable measure (Tailwind Typography,
// tuned in global.css). `lead` enlarges the first paragraph.
interface Props {
  lead?: boolean;
}

const { lead = false } = Astro.props;
---

<article class:list={['prose prose-lg reveal max-w-[40rem]', { 'prose-lead': lead }]}>
  <slot />
</article>
