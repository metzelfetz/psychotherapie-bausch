---
// Loads nothing until the visitor clicks "Karte laden" – no request to
// OpenStreetMap (or even the Leaflet JS chunk) before then. See
// conventions.md invariant 2 and plan.md's map decision.
import { practice } from '../data/practice';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
---

<div class="reveal">
  <div
    id="map-consent"
    class="flex min-h-72 flex-col items-center justify-center gap-5 rounded-[2rem] border border-base-300 bg-base-200 p-8 text-center"
  >
    <svg class="h-9 w-9 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" />
    </svg>
    <p class="max-w-md text-muted">{tr('map.consent')}</p>
    <button id="map-load-btn" type="button" class="btn btn-primary">{tr('map.load')}</button>
  </div>
  <div
    id="map-container"
    class="hidden h-[26rem] w-full overflow-hidden rounded-[2rem]"
    data-lat={practice.geo.lat}
    data-lng={practice.geo.lng}
    aria-label={tr('map.alt')}
  >
  </div>
</div>

<script>
  const btn = document.getElementById('map-load-btn');

  btn?.addEventListener(
    'click',
    async () => {
      const consent = document.getElementById('map-consent');
      const container = document.getElementById('map-container');
      if (!container) return;

      const [{ default: L }] = await Promise.all([
        import('leaflet'),
        import('leaflet/dist/leaflet.css'),
      ]);
      // The `?url` suffix asks Vite for a plain URL string. Without it,
      // Astro's asset pipeline turns a .png import into an ImageMetadata
      // object instead, which breaks Leaflet's marker icon options.
      const [markerIcon2x, markerIcon, markerShadow] = await Promise.all([
        import('leaflet/dist/images/marker-icon-2x.png?url'),
        import('leaflet/dist/images/marker-icon.png?url'),
        import('leaflet/dist/images/marker-shadow.png?url'),
      ]);
      // A plain L.icon(), not L.Icon.Default: the default icon class always
      // prefixes an auto-detected imagePath in front of these URLs, which
      // breaks them since they are already full paths.
      const icon = L.icon({
        iconUrl: markerIcon.default,
        iconRetinaUrl: markerIcon2x.default,
        shadowUrl: markerShadow.default,
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41],
      });

      consent?.remove();
      container.classList.remove('hidden');

      const lat = Number(container.dataset.lat);
      const lng = Number(container.dataset.lng);
      const map = L.map(container).setView([lat, lng], 17);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);
      L.marker([lat, lng], { icon }).addTo(map);
    },
    { once: true },
  );
</script>
