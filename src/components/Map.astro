---
// Loads nothing until the visitor clicks "Karte laden" – no request to
// OpenStreetMap (or even the Leaflet JS chunk) before then. See
// conventions.md invariant 2 and plan.md's map decision.
// Any number of instances per page: one click on any of their buttons loads
// every map on the page.
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  lat: number;
  lng: number;
  /** Place name for the map's accessible label, e.g. "Schopfheim". */
  place: string;
}

const { lang, lat, lng, place } = Astro.props;
const tr = t(lang);
---

<div class="map-instance">
  <div
    class="map-consent flex min-h-60 flex-col items-center justify-center gap-4 rounded-box border border-base-300 bg-base-200 p-6 text-center"
  >
    <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" />
    </svg>
    <p class="max-w-xs text-[0.95rem] leading-snug text-muted">{tr('map.consent')}</p>
    <button type="button" class="map-load-btn btn btn-primary btn-sm">{tr('map.load')}</button>
  </div>
  <div
    class="map-container hidden h-60 w-full overflow-hidden rounded-box"
    data-lat={lat}
    data-lng={lng}
    aria-label={`${tr('map.alt')} ${place}`}
  >
  </div>
</div>

<script>
  let loading: Promise<void> | undefined;

  async function loadAllMaps() {
    const [{ default: L }] = await Promise.all([
      import('leaflet'),
      import('leaflet/dist/leaflet.css'),
    ]);
    // The `?url` suffix asks Vite for a plain URL string. Without it,
    // Astro's asset pipeline turns a .png import into an ImageMetadata
    // object instead, which breaks Leaflet's marker icon options.
    const [markerIcon2x, markerIcon, markerShadow] = await Promise.all([
      import('leaflet/dist/images/marker-icon-2x.png?url'),
      import('leaflet/dist/images/marker-icon.png?url'),
      import('leaflet/dist/images/marker-shadow.png?url'),
    ]);
    // A plain L.icon(), not L.Icon.Default: the default icon class always
    // prefixes an auto-detected imagePath in front of these URLs, which
    // breaks them since they are already full paths.
    const icon = L.icon({
      iconUrl: markerIcon.default,
      iconRetinaUrl: markerIcon2x.default,
      shadowUrl: markerShadow.default,
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    document.querySelectorAll<HTMLElement>('.map-instance').forEach((instance) => {
      const container = instance.querySelector<HTMLElement>('.map-container');
      if (!container) return;
      instance.querySelector('.map-consent')?.remove();
      container.classList.remove('hidden');

      const lat = Number(container.dataset.lat);
      const lng = Number(container.dataset.lng);
      const map = L.map(container, { scrollWheelZoom: false }).setView([lat, lng], 16);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);
      L.marker([lat, lng], { icon }).addTo(map);
    });
  }

  document.querySelectorAll('.map-load-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      loading ??= loadAllMaps();
    }),
  );
</script>
