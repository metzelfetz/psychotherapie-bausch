---
import { crisisLines, locations, mapsUrl, practice } from '../data/practice';
import { pagesFor, urlFor } from '../i18n/pages';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
// Lets a narrow column wrap the address after the @, not mid-word.
const emailParts = practice.email.split('@');
const legalPages = (await pagesFor(lang)).filter((p) => p.data.layout === 'legal');
const labelClass = 'mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-neutral-content';
const linkClass = 'underline decoration-base-100/35 underline-offset-4 hover:decoration-base-100';
---

<footer class="bg-neutral px-4 pt-12 pb-6 text-base-100 md:pt-18">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-7 md:grid-cols-[1.6fr_1fr] md:gap-10">
      <div>
        <p class="mb-1 font-serif text-2xl">{practice.practiceName[lang]}</p>
        <p class="mb-4 text-neutral-content">{practice.tagline[lang]}</p>
        <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
          {locations.map((l) => (
            <address class="not-italic leading-relaxed text-neutral-content">
              <span class="font-semibold text-base-100">{tr('location.prefix')} {l.city}</span><br />
              <a class={linkClass} href={mapsUrl(l)} target="_blank" rel="noopener">{l.street}<br />{l.postalCode} {l.city}</a>
            </address>
          ))}
        </div>
      </div>
      <div>
        <p class={labelClass}>{tr('footer.contact')}</p>
        <p class="mb-1">{tr('footer.phone')}: <a class={linkClass} href={practice.phone.href}>{practice.phone.display}</a></p>
        <p>{tr('footer.email')}: <a class={linkClass} href={`mailto:${practice.email}`}>{emailParts[0]}@<wbr />{emailParts[1]}</a></p>
      </div>
    </div>

    <div role="note" class="mt-11 flex items-start gap-3.5 rounded-2xl border border-base-100/20 bg-base-100/5 px-5 py-4 leading-relaxed text-neutral-content">
      <svg class="mt-1 h-5 w-5 flex-none text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21s-7-4.4-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12C19 16.6 12 21 12 21z" />
      </svg>
      <p>
        <strong class="font-semibold text-base-100">{tr('crisis.title')}</strong>{' '}
        {tr('crisis.emergency')}{' '}
        <a class={`${linkClass} whitespace-nowrap font-semibold text-base-100`} href={crisisLines.emergency.href}>{crisisLines.emergency.display}</a>{' '}
        {tr('crisis.hotline')}{' '}
        <a class={`${linkClass} whitespace-nowrap font-semibold text-base-100`} href={crisisLines.telefonSeelsorge.href}>{crisisLines.telefonSeelsorge.display}</a>.
      </p>
    </div>

    <div class="mt-8 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-base-100/15 pt-5 text-sm text-neutral-content">
      <span>© {new Date().getFullYear()} {practice.name}</span>
      <nav aria-label={tr('footer.legal')} class="flex gap-5">
        {legalPages.map((p) => (
          <a class={linkClass} href={urlFor(lang, p.data.slug)}>{p.data.title}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
