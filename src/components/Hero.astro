---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mailto, practice } from '../data/practice';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  lead?: string;
  /** One string per paragraph. */
  text: string[];
  /** Anchor id, when the hero is a nav target on the one-pager. */
  anchor?: string;
  image: ImageMetadata;
  imageAlt: string;
  variant: 'photo' | 'portrait';
}

const { lang, eyebrow, title, lead, text, image, imageAlt, variant, anchor } = Astro.props;
const tr = t(lang);
// A title ending in a comma ("Schön,") continues into the lead, so both
// share one headline; otherwise the lead is its own line below it.
const leadInline = lead && title.trimEnd().endsWith(',');
---

<section id={anchor} class="scroll-mt-22 px-4 pt-5 pb-12 md:scroll-mt-24 md:pt-11 md:pb-20">
  <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-[1fr_1.05fr] md:gap-16">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {leadInline ? (
        <h1 class="text-[clamp(2.4rem,4.6vw,3.8rem)]">
          {title} <em class="font-[350] text-primary">{lead}</em>
        </h1>
      ) : (
        <h1 class="text-[clamp(2.6rem,5.5vw,4.4rem)]">{title}</h1>
      )}
      {lead && !leadInline && (
        <p class="mt-2.5 font-serif text-[clamp(1.5rem,2.6vw,2rem)] leading-tight text-primary italic">{lead}</p>
      )}
      <div class="mt-6 mb-8 flex max-w-[34rem] flex-col gap-4">
        {text.map((p) => <p>{p}</p>)}
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={mailto(lang)} class="btn btn-primary btn-lg">{tr('cta.email')}</a>
        <!-- Plain text, not a link, so the address can be copied into any mail program. -->
        <p class="text-secondary-content">
          {tr('cta.address')} <span class="font-semibold whitespace-nowrap select-all">{practice.email}</span>
        </p>
      </div>
    </div>
    <div class="hero-media -order-1 md:order-none">
      {variant === 'portrait' ? (
        <div class="portrait-frame mx-auto w-full max-w-72 md:mr-0 md:ml-auto md:max-w-[26rem]">
          <Image src={image} alt={imageAlt} widths={[320, 480, 640, 960]} sizes="(min-width: 768px) 26rem, 18rem" class="h-auto w-full" loading="eager" />
        </div>
      ) : (
        <div class="photo-frame">
          <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto" loading="eager" />
        </div>
      )}
    </div>
  </div>
</section>
