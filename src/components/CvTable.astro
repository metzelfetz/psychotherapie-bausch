---
interface Entry {
  period: string;
  text: string;
}

interface Props {
  cv: Entry[];
  trainings?: string[];
  /** Row label for the trainings row; passed by the caller so this stays language-neutral. */
  trainingsLabel?: string;
}

const { cv, trainings, trainingsLabel = 'Weiterbildungen' } = Astro.props;
---

<table class="table not-prose">
  <tbody>
    {cv.map((row) => (
      <tr>
        <th scope="row" class="w-48 align-top font-normal text-base-content/70">{row.period}</th>
        <td set:html={row.text} />
      </tr>
    ))}
    {trainings && trainings.length > 0 && (
      <tr>
        <th scope="row" class="align-top font-normal text-base-content/70">{trainingsLabel}</th>
        <td>
          <ul class="list-disc pl-5">
            {trainings.map((item) => <li>{item}</li>)}
          </ul>
        </td>
      </tr>
    )}
  </tbody>
</table>
