---
import { mailto, practice } from '../data/practice';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The page's closing sentence (frontmatter `cta`). */
  text: string;
}

const { lang, text } = Astro.props;
const tr = t(lang);
---

<div class="reveal grid items-center gap-8 rounded-[2rem] bg-secondary p-8 md:grid-cols-[1.4fr_1fr] md:p-14">
  <p class="font-serif text-[clamp(1.45rem,2.4vw,1.9rem)] leading-snug">{text}</p>
  <div class="flex flex-col items-start gap-3.5">
    <a href={mailto(lang)} class="btn btn-primary btn-lg">
      {tr('cta.email')} <span class="arrow" aria-hidden="true">→</span>
    </a>
    <a href={practice.phone.href} class="font-semibold text-secondary-content hover:underline hover:underline-offset-4">
      {tr('cta.call')} {practice.phone.display}
    </a>
    <p class="relative mt-1 pl-6 text-[0.9rem] leading-normal text-secondary-content">
      <svg class="absolute top-0.5 left-0 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
      </svg>
      {tr('cta.privacy')}
    </p>
  </div>
</div>
